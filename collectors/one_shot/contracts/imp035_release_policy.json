{
  "contract_version": "1.0.0",
  "imp": "IMP-035",
  "development_profile": {
    "id": "DEV-EPHEMERAL-AUTHENTICODE",
    "purpose": "코드서명 pipeline과 fail-closed 검증을 위한 개발 인수",
    "publisher_subject_prefix": "CN=Sec_AI IMP-035 DEV Publisher",
    "self_signed_dev_trust_anchor": true,
    "install_dev_root_in_windows_trust_store": false,
