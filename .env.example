# This file contains safe examples only. Copy it to .env and fill values locally.
# Never add passwords, tokens, private keys, AIStor licenses, or real evidence here.
SECAI_ENV=dev
SECAI_PUBLIC_ORIGIN=http://localhost:18480
# Reserved for the future HTTPS Pilot profile; DEV-LOCAL does not use WebAuthn.
SECAI_WEBAUTHN_RP_ID=localhost
SECAI_AUTH_ENABLED=true
SECAI_AUTH_PROFILE=DEV-LOCAL
SECAI_AUTH_CANONICAL_ORIGIN=http://localhost:18480
SECAI_LOG_LEVEL=INFO
SECAI_TIMEZONE=Asia/Seoul
SECAI_GATEWAY_BIND=127.0.0.1
SECAI_GATEWAY_PORT=18480
SECAI_PGADMIN_BIND=127.0.0.1
SECAI_PGADMIN_PORT=18490

# OpenAI-compatible model connector. Current development uses OpenRouter.
# For local vLLM, change only API_BASE and MODEL; keep the same /v1 contract.
SECAI_LLM_API_BASE=https://openrouter.ai/api/v1
SECAI_LLM_MODEL=openai/gpt-oss-120b
SECAI_CHAT_LIVE_ENABLED=false
SECAI_LLM_REASONING_EFFORT=low
SECAI_LLM_REQUEST_TIMEOUT_SECONDS=240
SECAI_LLM_FAST_MAX_OUTPUT_TOKENS=8000
SECAI_LLM_PRECISE_MAX_OUTPUT_TOKENS=16000
SECAI_RESULT_AI_TIMEOUT_SECONDS=260
SECAI_RESULT_AI_BATCH_SIZE=6

# Guide retrieval and reranking tuning (non-secret).
# FAST/PRECISE are final citation counts; GuideSearchScope limits each to 1..20.
SECAI_GUIDE_SEARCH_MODE=BGE_M3_WITH_LEGACY_FALLBACK
SECAI_EMBEDDING_URL=http://embedding-service:80
SECAI_RERANKER_URL=http://reranker-service:80
SECAI_SEARCH_MODEL_TIMEOUT_SECONDS=30
SECAI_GUIDE_SEARCH_FAST_TOP_K=5
SECAI_GUIDE_SEARCH_PRECISE_TOP_K=10
SECAI_GUIDE_SEARCH_RESULT_TOP_K=5
# Query expansion -> reranker candidates -> database vector candidates.
SECAI_GUIDE_SEARCH_QUERY_EXPANSION_LIMIT=6
SECAI_GUIDE_SEARCH_CANDIDATE_MULTIPLIER=4
SECAI_GUIDE_SEARCH_CANDIDATE_LIMIT=20
SECAI_GUIDE_SEARCH_DB_CANDIDATE_MULTIPLIER=4
SECAI_GUIDE_SEARCH_DB_CANDIDATE_LIMIT=100
# Each weight pair must total exactly 1.0.
SECAI_GUIDE_SEARCH_RRF_K=60
SECAI_GUIDE_SEARCH_DENSE_WEIGHT=0.15
SECAI_GUIDE_SEARCH_LEXICAL_WEIGHT=0.85
SECAI_GUIDE_SEARCH_BASE_WEIGHT=0.60
SECAI_GUIDE_SEARCH_RERANKER_WEIGHT=0.40
# A citation must pass both thresholds; 0.0 disables only that score threshold.
SECAI_GUIDE_SEARCH_MIN_RERANK_SCORE=0.30
SECAI_GUIDE_SEARCH_MIN_LEXICAL_SCORE=0.35

# Local vLLM is image/container preparation only and is not started by default.
# Future switch example after an approved model is placed in the named volume:
# SECAI_LLM_API_BASE=http://vllm:8000/v1
# SECAI_LLM_MODEL=<approved-served-model-name>
# SECAI_VLLM_MODEL_PATH=/models/<approved-model-directory>
SECAI_VLLM_SERVED_MODEL=NOT_CONFIGURED
SECAI_LOCAL_VLLM_STATUS=PREPARED_NOT_ACTIVE
SECAI_LOCAL_VLLM_IMAGE=sec-ai-mvp/vllm-openai-gpu:0.23.0
SECAI_LOCAL_VLLM_IMAGE_DIGEST=sha256:48f9f370497eee3748a693c01030c82dbcee87a0db52f5e7901c9744787f4a00
SECAI_LOCAL_VLLM_BASE_DIGEST=sha256:3a1e7f5904e1a1192a02aa0086ceaffc33985d7044c7bb25b3a43d61bdbe3ac0
SECAI_LOCAL_VLLM_RUNTIME_GATE=BLOCKED_VULNERABILITIES_GPU_MODEL

# Non-secret internal service coordinates.
SECAI_POSTGRES_DB=secai
SECAI_POSTGRES_USER=secai_app
SECAI_POSTGRES_MIGRATOR_USER=secai_app
SECAI_POSTGRES_RUNTIME_USER=secai_runtime
SECAI_POSTGRES_DB_ADMIN_USER=secai_db_admin
SECAI_REDIS_USER=secai_celery

# Secret file locations inside containers. The files are provisioned separately.
SECAI_POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
SECAI_REDIS_PASSWORD_FILE=/run/secrets/redis_password
SECAI_AISTOR_LICENSE_FILE=/run/secrets/minio.license
SECAI_AUTH_SESSION_INDEX_KEY_FILE=/run/secrets/auth_session_index_key
SECAI_AUTH_DEV_PASSWORD_FILE=/run/secrets/auth_dev_password
SECAI_AUTH_DEV_MFA_CODE_FILE=/run/secrets/auth_dev_mfa_code
SECAI_LLM_API_KEY_FILE=/run/secrets/llm_api_key
SECAI_LLM_GATEWAY_TOKEN_FILE=/run/secrets/model_gateway_token
