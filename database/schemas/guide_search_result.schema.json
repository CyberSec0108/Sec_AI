{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sec-ai.local/v1/guide_search_result.schema.json",
  "title": "Sec_AI Guide Search Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "organization_id",
    "guide",
    "scope_id",
    "query_sha256",
    "provider",
    "vector_generation_id",
    "status",
    "hits"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "format": "uuid"},
    "organization_id": {"type": "string", "format": "uuid"},
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guide_id", "version"],
      "properties": {
        "guide_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "scope_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "query_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider": {"const": "POSTGRES_PGVECTOR"},
    "vector_generation_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["FOUND", "NO_EVIDENCE", "CONFLICT", "UNAVAILABLE"]},
    "reason_code": {
      "type": ["string", "null"],
      "enum": [
        null,
        "NO_MATCH_IN_APPROVED_SCOPE",
        "INSUFFICIENT_RELEVANCE",
        "CITATION_LINEAGE_INVALID",
        "APPROVED_GUIDES_CONFLICT",
        "SCHEMA_MISMATCH",
        "NO_ACTIVE_GENERATION",
        "GUIDE_NOT_APPROVED"
      ]
    },
    "hits": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "guide_id",
          "guide_version",
          "scope_id",
          "pdf_page_number",
          "control_id",
          "document_code",
          "section_label",
          "paragraph_ordinal",
          "paragraph_sha256",
          "source_sha256",
          "text_sha256",
          "dense_score",
          "lexical_score",
          "rerank_score"
        ],
        "properties": {
          "chunk_id": {"type": "string", "format": "uuid"},
          "guide_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "guide_version": {"type": "string", "minLength": 1, "maxLength": 64},
          "scope_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "pdf_page_number": {"type": "integer", "minimum": 1},
          "control_id": {"type": "string", "pattern": "^PC-(0[1-9]|1[0-8])$"},
          "document_code": {"type": "string", "minLength": 1, "maxLength": 128},
          "section_label": {"type": "string", "minLength": 1, "maxLength": 256},
          "paragraph_ordinal": {"type": "integer", "minimum": 1},
          "paragraph_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "dense_score": {"type": "number", "minimum": 0, "maximum": 1},
          "lexical_score": {"type": "number", "minimum": 0, "maximum": 1},
          "rerank_score": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
