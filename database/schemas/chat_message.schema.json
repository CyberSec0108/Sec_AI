{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sec-ai.local/v1/chat_message.schema.json",
  "title": "Sec_AI Append-only Chat Message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "thread_id",
    "branch_id",
    "role",
    "status",
    "revision",
    "parent_message_id",
    "edit_of_message_id",
    "retry_of_message_id",
    "content",
    "content_sha256",
    "citations",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "message_id": {"type": "string", "format": "uuid"},
    "thread_id": {"type": "string", "format": "uuid"},
    "branch_id": {"type": "string", "format": "uuid"},
    "role": {"enum": ["USER", "ASSISTANT"]},
    "status": {
      "enum": ["PENDING", "COMPLETED", "STOPPED", "FAILED", "SUPERSEDED"]
    },
    "revision": {"type": "integer", "minimum": 1},
    "parent_message_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "edit_of_message_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "retry_of_message_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "content": {"type": "string", "maxLength": 24000},
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "citations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "https://schemas.sec-ai.local/v1/chat_citation.schema.json"
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "COMPLETED"}},
        "required": ["status"]
      },
      "then": {
        "properties": {"content": {"minLength": 1}}
      }
    },
    {
      "if": {
        "properties": {"role": {"const": "USER"}},
        "required": ["role"]
      },
      "then": {
        "properties": {"citations": {"maxItems": 0}}
      }
    }
  ]
}
