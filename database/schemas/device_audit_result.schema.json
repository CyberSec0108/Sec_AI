{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sec-ai.local/v1/device_audit_result.schema.json",
  "title": "Sec_AI multi-device read-only audit result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "asset", "benchmark", "criteria_profile_id",
    "criteria_sha256", "started_at", "completed_at", "controls",
    "raw_evidence_included", "status_authority", "result_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "format": "uuid"},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "asset_type", "platform", "platform_version", "vendor", "product_family"],
      "properties": {
        "asset_id": {"type": "string", "format": "uuid"},
        "asset_type": {"enum": ["WINDOWS_PC", "LINUX_SERVER", "NETWORK_SWITCH"]},
        "platform": {"enum": ["WINDOWS", "LINUX", "CISCO_IOS", "ARUBA_AOS_CX"]},
        "platform_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "vendor": {"type": "string", "minLength": 1, "maxLength": 80},
        "product_family": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "criteria_profile_id": {"type": ["string", "null"], "format": "uuid"},
    "criteria_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/control"}
    },
    "raw_evidence_included": {"const": false},
    "status_authority": {"const": "RULE_ENGINE"},
    "result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id", "title", "status", "status_authority", "result_code",
        "result_code_visibility", "expected_summary", "observed_summary",
        "action_guidance", "evidence", "official_finding_write_allowed"
      ],
      "properties": {
        "control_id": {"type": "string", "pattern": "^(PC|LIN|SW)-[0-9]{2}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "status": {"enum": ["PASS", "FAIL", "ERROR", "REVIEW", "N/A"]},
        "status_authority": {"const": "RULE_ENGINE"},
        "result_code": {"type": "string", "pattern": "^[A-Z0-9_.:-]{1,128}$"},
        "result_code_visibility": {"const": "TECHNICAL_ONLY"},
        "expected_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "observed_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "action_guidance": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "official_finding_write_allowed": {"const": false}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id", "probe_version", "method_code", "method_summary",
        "source_label", "technical_locator", "observed_summary", "collected_at",
        "collection_status", "raw_output_sha256", "normalized_sha256",
        "redaction_applied", "raw_output_included"
      ],
      "properties": {
        "probe_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "probe_version": {"type": "string", "minLength": 1, "maxLength": 32},
        "method_code": {"type": "string", "pattern": "^[A-Z0-9_.:-]{1,128}$"},
        "method_summary": {"type": "string", "minLength": 1, "maxLength": 400},
        "source_label": {"type": "string", "minLength": 1, "maxLength": 200},
        "technical_locator": {"type": "string", "minLength": 1, "maxLength": 400},
        "observed_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "collected_at": {"type": "string", "format": "date-time"},
        "collection_status": {"enum": ["COLLECTED", "ERROR", "UNSUPPORTED"]},
        "raw_output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "normalized_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "redaction_applied": {"type": "boolean"},
        "raw_output_included": {"const": false}
      }
    }
  }
}
