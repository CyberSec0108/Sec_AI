{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sec-ai.local/v1/grounded_ai_response.schema.json",
  "title": "Sec_AI grounded guide answer or Finding explanation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "status",
    "reason_code",
    "answer",
    "citations",
    "model_id",
    "prompt",
    "input_sha256",
    "output_sha256",
    "official_finding_status",
    "safety"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "mode": {"enum": ["GUIDE_QA", "FINDING_EXPLAIN"]},
    "status": {
      "enum": [
        "GENERATED",
        "NO_EVIDENCE",
        "DOCUMENT_CONFLICT",
        "EXTERNAL_TRANSFER_BLOCKED",
        "SECURITY_BLOCKED",
        "MODEL_UNAVAILABLE",
        "GENERATION_FAILED"
      ]
    },
    "reason_code": {"type": ["string", "null"], "maxLength": 128},
    "answer": {"type": ["string", "null"], "minLength": 1, "maxLength": 12000},
    "citations": {
      "type": "array",
      "maxItems": 8,
      "items": {"$ref": "#/$defs/citation"}
    },
    "model_id": {"type": ["string", "null"], "maxLength": 200},
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "template_version", "template_sha256"],
      "properties": {
        "template_id": {
          "type": "string",
          "const": "secai-grounded-korean-answer"
        },
        "template_version": {"type": "string", "const": "1.0.0"},
        "template_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "input_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "official_finding_status": {
      "type": ["string", "null"],
      "enum": ["PASS", "FAIL", "ERROR", "REVIEW", "N/A", null]
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_finding_write_allowed",
        "audit_pack_write_allowed",
        "executable_content_present"
      ],
      "properties": {
        "official_finding_write_allowed": {"const": false},
        "audit_pack_write_allowed": {"const": false},
        "executable_content_present": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "GENERATED"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "reason_code": {"const": null},
          "answer": {"type": "string"},
          "citations": {"minItems": 1},
          "model_id": {"type": "string"},
          "input_sha256": {"type": "string"},
          "output_sha256": {"type": "string"}
        }
      },
      "else": {
        "properties": {
          "reason_code": {"type": "string"},
          "answer": {"const": null}
        }
      }
    },
    {
      "if": {
        "properties": {"mode": {"const": "FINDING_EXPLAIN"}},
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "official_finding_status": {
            "enum": ["PASS", "FAIL", "ERROR", "REVIEW", "N/A"]
          }
        }
      },
      "else": {
        "properties": {"official_finding_status": {"const": null}}
      }
    }
  ],
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "guide_id",
        "guide_version",
        "document_code",
        "source_sha256",
        "scope_id",
        "pdf_page_number",
        "control_id",
        "section_label",
        "paragraph_ordinal",
        "paragraph_sha256",
        "text_sha256"
      ],
      "properties": {
        "chunk_id": {"type": "string", "format": "uuid"},
        "guide_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "guide_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "document_code": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scope_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "pdf_page_number": {"type": "integer", "minimum": 1},
        "control_id": {"type": "string", "pattern": "^PC-(0[1-9]|1[0-8])$"},
        "section_label": {"type": "string", "minLength": 1, "maxLength": 256},
        "paragraph_ordinal": {"type": "integer", "minimum": 1},
        "paragraph_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
