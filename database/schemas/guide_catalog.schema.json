{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sec-ai.local/v1/guide_catalog.schema.json",
  "title": "Sec_AI Guide Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "guides"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "guides": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/guide"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "page_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "section_label",
        "pdf_page_start",
        "pdf_page_end",
        "default_enabled"
      ],
      "properties": {
        "scope_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "section_label": {"type": "string", "minLength": 1, "maxLength": 128},
        "pdf_page_start": {"type": "integer", "minimum": 1},
        "pdf_page_end": {"type": "integer", "minimum": 1},
        "default_enabled": {"type": "boolean"}
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guide_id",
        "version",
        "document_code",
        "publisher",
        "title",
        "edition",
        "language",
        "classification",
        "status",
        "source",
        "license_policy",
        "access_scope",
        "query_scopes",
        "gates",
        "audit_pack_activation_allowed"
      ],
      "properties": {
        "guide_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "document_code": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
        },
        "publisher": {"type": "string", "minLength": 1, "maxLength": 128},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "edition": {"type": "string", "minLength": 1, "maxLength": 128},
        "language": {"enum": ["ko", "en"]},
        "classification": {
          "enum": [
            "PUBLIC_SOURCE_UNCONFIRMED_LICENSE",
            "PUBLIC_SOURCE_INTERNAL_APPROVED",
            "INTERNAL",
            "RESTRICTED"
          ]
        },
        "status": {"enum": ["DRAFT", "APPROVED", "RETIRED", "REVOKED"]},
        "supersedes": {
          "type": ["string", "null"],
          "maxLength": 192
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relative_path",
            "media_type",
            "source_sha256",
            "size_bytes",
            "page_count",
            "pdf_version",
            "encrypted",
            "metadata_created_at"
          ],
          "properties": {
            "relative_path": {
              "type": "string",
              "pattern": "^data/[^/]+\\.pdf$",
              "maxLength": 512
            },
            "media_type": {"const": "application/pdf"},
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "size_bytes": {"type": "integer", "minimum": 1},
            "page_count": {"type": "integer", "minimum": 1},
            "pdf_version": {
              "type": "string",
              "pattern": "^PDF [0-9]+\\.[0-9]+$"
            },
            "encrypted": {"type": "boolean"},
            "metadata_created_at": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        },
        "license_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "allowed_use",
            "redistribution_allowed",
            "derivative_text_storage_allowed",
            "review_note"
          ],
          "properties": {
            "status": {"enum": ["REVIEW_REQUIRED", "APPROVED", "DENIED"]},
            "allowed_use": {
              "enum": [
                "LOCAL_INTERNAL_DEVELOPMENT_ONLY",
                "APPROVED_INTERNAL_GUIDE_QA",
                "NO_USE"
              ]
            },
            "redistribution_allowed": {"type": "boolean"},
            "derivative_text_storage_allowed": {"type": "boolean"},
            "review_note": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        },
        "access_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope_type", "roles"],
          "properties": {
            "scope_type": {
              "enum": ["PROJECT_LOCAL_DEVELOPMENT", "ORGANIZATION"]
            },
            "roles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["USER", "SECURITY_OFFICER", "APPROVER", "ADMIN"]
              }
            }
          }
        },
        "query_scopes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/page_range"}
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_hash_verified",
            "page_map_verified",
            "visual_anchor_verified",
            "malware_scan_passed",
            "ocr_quality_approved",
            "license_review_approved",
            "retrieval_quality_approved"
          ],
          "properties": {
            "source_hash_verified": {"type": "boolean"},
            "page_map_verified": {"type": "boolean"},
            "visual_anchor_verified": {"type": "boolean"},
            "malware_scan_passed": {"type": "boolean"},
            "ocr_quality_approved": {"type": "boolean"},
            "license_review_approved": {"type": "boolean"},
            "retrieval_quality_approved": {"type": "boolean"}
          }
        },
        "audit_pack_activation_allowed": {"type": "boolean"}
      }
    }
  }
}
